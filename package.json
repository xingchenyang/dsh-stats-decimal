{
  "name": "dsh-stats-decimal",
  "version": "0.5.0",
  "type": "module",
  "main": "lib/index.js",
  "description": "DSH v0.1.5-rc.1 plugin: preserves the native StatsPills and adds CNY/USD cost, recharge balance, and Beijing-time pricing-period status.",
  "scripts": {
    "test": "node --test",
    "check:upstream": "node scripts/check-deepseek-docs.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./pricing": {
      "default": "./lib/pricing.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT"
}
